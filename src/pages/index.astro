---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CalendlySection from '../components/CalendlySection.astro';
import BarrioTag from '../components/BarrioTag.astro';
import MaterialFormativo from '../components/MaterialFormativo.astro';
import CTABox from '../components/CTABox.astro';
import barriosData from '../data/barrios.json';
import serviciosData from '../data/servicios.json';

const faqItems = [
  {
    question: "¿Dónde está vuestra consulta de nutrición en Alcorcón?",
    answer: "Nos encontrarás en la Calle Pablo Picasso 3, en pleno Alcorcón. La zona cuenta con paradas cercanas de Metro Ligero y autobuses urbanos, además de aparcamiento en superficie en las calles colindantes."
  },
  {
    question: "¿Quiénes son las nutricionistas de la consulta en Alcorcón?",
    answer: "En Alcorcón te atenderán Paula Lenza y Arancha Fontán, dietistas-nutricionistas colegiadas con amplia experiencia en reeducación alimentaria, pérdida de grasa y nutrición clínica. Forman parte del equipo de nutricionista.io y trabajan con el mismo método que aplicamos en el resto de nuestras clínicas del sur de Madrid."
  },
  {
    question: "¿Qué ocurre en la primera consulta de nutrición?",
    answer: "Paula o Arancha realizarán una entrevista en profundidad para conocer tus hábitos, tu rutina diaria, posibles intolerancias y tus metas concretas. En un plazo máximo de 72 horas recibirás por correo electrónico tu plan nutricional completo, con menús semanales adaptados, recetas prácticas y tu lista de la compra."
  },
  {
    question: "¿Con qué frecuencia se hacen las revisiones?",
    answer: "Programamos las revisiones cada 21 días. En cada una evaluaremos tu evolución, resolveremos las dudas que hayan surgido y ajustaremos tu plan según tus necesidades. Entre visitas puedes consultarnos por WhatsApp sin coste extra."
  },
  {
    question: "¿Cuánto cuesta el nutricionista en Alcorcón?",
    answer: "Primera consulta: 50€ (entrevista completa + plan nutricional + material formativo). Revisión: 40€. Pack de 4 sesiones (primera + 3 revisiones): 140€ — te ahorras 30€ respecto a contratarlas por separado. Aceptamos efectivo, tarjeta y Bizum."
  },
  {
    question: "¿Necesitaré comprar suplementos o productos especiales?",
    answer: "No. Nuestras nutricionistas en Alcorcón basan todo su trabajo en alimentación real, con productos que encuentras en cualquier supermercado. Sin suplementos obligatorios, sin batidos, sin gasto adicional."
  },
  {
    question: "¿Cuál es el horario de la consulta?",
    answer: "De lunes a viernes en horario de mañana (10:00 a 14:00) y de tarde (15:30 a 20:30). Puedes reservar llamando al 611 85 98 98, por WhatsApp al mismo número o directamente a través del calendario de esta página."
  },
  {
    question: "¿También ofrecéis consulta online?",
    answer: "Sí. Además de la consulta presencial en Alcorcón, disponemos de consulta online por videollamada con idéntica calidad, planificación personalizada y seguimiento. Es ideal si tienes dificultad para desplazarte o vives fuera de Alcorcón."
  },
  {
    question: "¿Trabajáis con deportistas?",
    answer: "Por supuesto. Tenemos experiencia en nutrición aplicada al deporte: running, CrossFit, pádel, ciclismo, natación y entrenamiento de fuerza. Adaptamos tu alimentación a tus sesiones, competiciones y objetivos de rendimiento o composición corporal."
  },
  {
    question: "¿Puedo acudir si tengo alguna enfermedad o patología?",
    answer: "Sí. Trabajamos con diabetes tipo 2, colesterol, hipertensión, SOP, trastornos digestivos (SIBO, colon irritable, intolerancias), menopausia y otras patologías. Si es necesario, nos coordinamos con tu médico de cabecera o especialista."
  }
];

const testimonials = [
  {
    quote: "Empecé sin muchas expectativas y en tres meses ya notaba una diferencia enorme. Los menús son fáciles de seguir y las recetas riquísimas.",
    author: "Lucía A.",
    rating: 5
  },
  {
    quote: "Lo que más valoro es que no me prohíben nada. Me han enseñado a tomar decisiones conscientes sin esa sensación de estar a dieta.",
    author: "Marcos D.",
    rating: 5
  },
  {
    quote: "Tras el embarazo necesitaba recuperarme y ganar energía. El plan se adaptó a mi lactancia y a mis horarios con el bebé. Encantada.",
    author: "Patricia V.",
    rating: 5
  },
  {
    quote: "Trabajo a turnos y pensaba que sería imposible organizarme. Me dieron un plan que encaja perfectamente con mis rotaciones.",
    author: "Daniel S.",
    rating: 5
  },
  {
    quote: "He bajado el colesterol sin medicación, solo con los cambios de alimentación que me recomendaron. Mi médico no se lo creía.",
    author: "Teresa G.",
    rating: 5
  },
  {
    quote: "La comunidad de WhatsApp es un plus enorme. Cada semana hay recetas nuevas e ideas que me ayudan a no caer en la rutina.",
    author: "Alberto R.",
    rating: 5
  },
  {
    quote: "Fui con mi pareja y nos organizaron un plan conjunto que tiene en cuenta nuestros gustos diferentes. Cenamos genial todas las noches.",
    author: "Cristina y Raúl",
    rating: 5
  },
  {
    quote: "Llevaba años con digestiones pesadas. En pocas semanas noté un alivio increíble. Ojalá hubiese venido antes.",
    author: "Inmaculada L.",
    rating: 5
  },
  {
    quote: "Me han quitado el miedo a la báscula. Ahora entiendo que el peso es solo un dato más y lo importante es cómo me siento.",
    author: "Sergio P.",
    rating: 5
  },
  {
    quote: "El material formativo que te entregan en cada revisión es un tesoro. He aprendido más en dos meses que en años leyendo por mi cuenta.",
    author: "Beatriz H.",
    rating: 5
  },
  {
    quote: "Me gusta que son muy claras y directas. Nada de tecnicismos ni humo: te explican las cosas para que las entiendas y las apliques.",
    author: "Pablo M.",
    rating: 5
  },
  {
    quote: "He recuperado la energía que creía haber perdido para siempre. Duermo mejor, entreno mejor y mi piel ha mejorado una barbaridad.",
    author: "Nuria C.",
    rating: 5
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HealthBusiness",
  "name": "Nutricionista en Alcorcón — Paula Lenza y Arancha Fontán",
  "description": "Consulta de nutrición en Alcorcón. Dietistas-nutricionistas colegiadas especializadas en pérdida de peso, nutrición deportiva, salud digestiva y hormonal.",
  "url": "https://nutricionista.io/nutricionista-en-alcorcon",
  "telephone": "+34611859898",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle Pablo Picasso, 3",
    "addressLocality": "Alcorcón",
    "addressRegion": "Madrid",
    "postalCode": "28921",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.3458,
    "longitude": -3.8268
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "10:00",
      "closes": "14:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "15:30",
      "closes": "20:30"
    }
  ],
  "priceRange": "40€ - 140€",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "38"
  }
};
---

<BaseLayout
  title="Nutricionista en Alcorcón | C/ Pablo Picasso 3 · Primera consulta 50€"
  description="Nutricionistas colegiadas en Alcorcón. Planes personalizados para perder peso, nutrición deportiva, salud digestiva y hormonal. C/ Pablo Picasso 3. Primera consulta 50€. Reserva hoy."
  schema={faqSchema}
>
  <Nav slot="nav" />

  <!-- Schema LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- 1. HERO — foto de ambas + vídeo vertical -->
  <Hero
    name="Nutricionista en Alcorcón"
    role="Tu cambio empieza aquí"
    showVideo={true}
    location="C/ Pablo Picasso 3 · Alcorcón"
    description=""
    benefits={[]}
  />

  <!-- Trust Strip -->
  <TrustStrip />

  <!-- 2. INTRO SEO — Texto largo para posicionamiento -->
  <section class="section" id="nutricionista-alcorcon">
    <div class="container">
      <div class="seo-intro">
        <h2 class="section-title">Tu nutricionista en Alcorcón: come mejor, vive mejor</h2>
        <div class="seo-intro__text">
          <p><strong>Somos Paula, Arancha y Antonio.</strong> A lo largo de los últimos 7 años hemos construido un sistema de trabajo que aplicamos en esta consulta y en el resto de centros que gestionamos en el sur de Madrid: <strong>Leganés, Fuenlabrada, Getafe y Móstoles.</strong></p>
          <p>Si necesitas una <strong>nutricionista en Alcorcón</strong> que se tome el tiempo de escucharte, que entienda tu día a día y que diseñe un plan adaptado a tu realidad, aquí nos tienes. No somos fans de las dietas restrictivas ni de los planes copiados: cada persona merece un enfoque único.</p>
          <p>Trabajamos sobre tres bases: <strong>comida de verdad</strong> (nada de sustitutivos ni batidos), <strong>formación nutricional</strong> (que sepas el porqué de cada elección) y <strong>seguimiento continuo</strong> (estamos contigo entre consultas por WhatsApp).</p>
          <p style="font-weight: 700; color: var(--text);">Sigue leyendo para descubrir cómo trabajamos y qué podemos hacer por ti.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PROCESO — ¿Cómo funciona? -->
  <section class="section section--warm" id="proceso">
    <div class="container">
      <h2 class="section-title">¿Cómo funciona el proceso?</h2>
      <div class="proceso-grid">
        <div class="proceso-card">
          <div class="proceso-icon">📋</div>
          <h3>Primera consulta</h3>
          <p>Analizamos tu punto de partida a fondo, rellenamos un cuestionario personalizado y trazamos la estrategia más adecuada para tu objetivo.</p>
        </div>
        <div class="proceso-card">
          <div class="proceso-icon">📩</div>
          <h3>Recibes tu plan</h3>
          <p>En 72 horas como máximo tendrás tu planificación nutricional en el correo. A partir de ese momento, estamos disponibles para cualquier consulta que surja.</p>
        </div>
        <div class="proceso-card">
          <div class="proceso-icon">📊</div>
          <h3>Revisiones periódicas</h3>
          <p>Cada 21 días revisamos juntas tu evolución, ajustamos el plan si es necesario y te entregamos nuevo material formativo para que sigas avanzando.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PRECIOS -->
  <section class="section" id="precios">
    <div class="container">
      <h2 class="section-title">Precios: Nutricionista en Alcorcón</h2>
      <p class="section-sub">Elige la modalidad que mejor encaje contigo.</p>

      <div class="pricing-row">
        <!-- Sesión individual -->
        <div class="price-basic">
          <div class="price-basic-label">Sesión individual</div>
          <div class="price-basic-header">Primera consulta</div>
          <div class="price-basic-amount">50<span>€</span></div>
          <ul class="price-basic-list">
            <li>✓ Entrevista inicial en profundidad</li>
            <li>✓ Plan nutricional a tu medida</li>
            <li>✓ Material formativo incluido</li>
          </ul>
          <div class="price-basic-revision">Revisiones sueltas: 40€/sesión</div>
          <a href="#reservar" class="price-basic-btn">PEDIR CITA</a>
        </div>

        <!-- Pack destacado -->
        <div class="price-pack">
          <div class="pack-badge-top">⭐ MÁS ELEGIDO — AHORRA 30€</div>
          <div class="pack-header">
            <h3>Pack: Primera + 3 Revisiones</h3>
            <p>La opción más completa</p>
          </div>
          <div class="pack-price-row">
            <div class="pack-old-price">170€</div>
            <div class="pack-new-price">140<span>€</span></div>
          </div>
          <div class="pack-savings">Ahorro de 30€ respecto a contratar por separado</div>
          <ul class="pack-features">
            <li>4 sesiones completas incluidas</li>
            <li>Plan nutricional + ajustes en cada visita</li>
            <li>Soporte por WhatsApp entre consultas</li>
            <li>Todo el material formativo</li>
            <li>Mayor compromiso, mejores resultados</li>
          </ul>
          <a href="#reservar" class="pack-btn">PEDIR CITA</a>
        </div>
      </div>

      <!-- Nota parejas -->
      <div class="parejas-note">
        <p class="parejas-title">💑 <strong>Consultas en pareja</strong></p>
        <p class="parejas-detail">Primera consulta pareja: 100€ · Revisión pareja: 55€ · Bono 4 consultas parejas: 220€</p>
        <a href="#reservar" class="parejas-btn">Reservar cita para 2 personas</a>
      </div>
    </div>
  </section>

  <!-- 5. UBICACIÓN + MAPA -->
  <section class="section section--alt" id="ubicacion">
    <div class="container">
      <h2 class="section-title">¿Dónde está nuestra consulta en Alcorcón?</h2>
      <div class="location-box">
        <div class="location-info">
          <div class="location-row">
            <span class="location-icon">📍</span>
            <div>
              <strong>Dirección</strong>
              <span>Calle Pablo Picasso 3, 28921 Alcorcón</span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">📞</span>
            <div>
              <strong>Teléfono</strong>
              <span><a href="tel:+34611859898">611 85 98 98</a></span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">💬</span>
            <div>
              <strong>WhatsApp</strong>
              <span><a href="https://wa.me/34611859898?text=Hola%2C%20quiero%20informarme%20sobre%20la%20consulta%20en%20Alcorcón" target="_blank" rel="noopener">611 85 98 98</a></span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">🕐</span>
            <div>
              <strong>Horarios</strong>
              <span>Lunes a Viernes: 10:00–14:00 / 15:30–20:30</span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">🚇</span>
            <div>
              <strong>Cómo llegar</strong>
              <span>Metro Ligero · Autobuses urbanos · Parking en superficie</span>
            </div>
          </div>
          <div class="location-actions">
            <a href="tel:+34611859898" class="loc-btn loc-btn--primary">Llamar al 611 85 98 98</a>
            <a href="https://wa.me/34611859898?text=Hola%2C%20quiero%20informarme%20sobre%20la%20consulta%20en%20Alcorcón" target="_blank" rel="noopener" class="loc-btn loc-btn--outline">Enviar WhatsApp</a>
          </div>
        </div>
        <div class="location-map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3013.5!2d-3.8268!3d40.3458!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd418fb6b64c03c5%3A0x4e6c5e1234567890!2sC.%20de%20Pablo%20Picasso%2C%203%2C%2028921%20Alcorcón!5e0!3m2!1ses!2ses!4v1710000000000!5m2!1ses!2ses"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Nutricionista en Alcorcón — C/ Pablo Picasso 3"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. RESERVA CITA (Calendly con tabs) -->
  <CalendlySection />

  <!-- 7. FAQ -->
  <section class="section section--warm" id="faq">
    <div class="container">
      <h2 class="section-title">Preguntas frecuentes sobre el nutricionista en Alcorcón</h2>
      <p class="section-sub">Resolvemos las dudas más habituales antes de tu primera visita:</p>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <!-- CTA intermedio -->
  <CTABox
    title="¿Preparado/a para dar el paso?"
    description="Reserva tu primera consulta con nuestras nutricionistas en Alcorcón. 50€, sin permanencia. Llama al 611 85 98 98 o escríbenos por WhatsApp."
    ctaText="Reservar mi cita"
    ctaHref="#reservar"
    variant="trust"
  />

  <!-- 8. QUÉ NOS DIFERENCIA -->
  <section class="section section--alt" id="diferencia">
    <div class="container">
      <h2 class="section-title">¿Por qué elegirnos como nutricionistas en Alcorcón?</h2>
      <div class="diff-text">
        <p>Nutricionista.io arrancó en 2017 con una sola persona. Hoy <strong>somos un equipo de 20 dietistas-nutricionistas</strong> con consultas presenciales en Alcorcón, Leganés, Fuenlabrada, Getafe y Móstoles, además de consulta online para toda España.</p>
        <p>Tras miles de pacientes atendidos, hemos depurado un método que pone el foco en lo que realmente genera resultados: <strong>comida real, educación nutricional y acompañamiento permanente.</strong> Sin atajos, sin promesas vacías.</p>
        <p>Cuando vienes a nuestra consulta en Alcorcón no solo te llevas un plan nutricional personalizado. Te entregamos las herramientas necesarias para que los cambios perduren:</p>
      </div>

      <!-- Tres pilares destacados -->
      <div class="pilares-grid">
        <div class="pilar-card">
          <div class="pilar-num">1</div>
          <h3>Dossiers formativos en cada revisión</h3>
          <p>Documentos prácticos sobre etiquetado, metabolismo, gestión de la saciedad, adherencia y mucho más. No solo te decimos qué comer: te explicamos por qué.</p>
        </div>
        <div class="pilar-card">
          <div class="pilar-num">2</div>
          <h3>Área de Pacientes privada</h3>
          <p>Acceso a más de 110 recursos: vídeos, guías descargables, infografías, calculadoras y recetarios organizados por temática.</p>
        </div>
        <div class="pilar-card">
          <div class="pilar-num">3</div>
          <h3>Grupo de WhatsApp semanal</h3>
          <p>Recetas, recomendaciones de productos, ideas de batch cooking y apoyo entre consultas. Nunca caminas solo/a en este proceso.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. MATERIAL FORMATIVO -->
  <section class="section" id="material">
    <div class="container">
      <h2 class="section-title">Material formativo incluido</h2>
      <p class="section-sub">En cada revisión con tu nutricionista en Alcorcón recibirás un dossier nuevo. Temas como el etiquetado, pérdida de grasa, metabolismo y adherencia:</p>
      <MaterialFormativo />
    </div>
  </section>

  <!-- 10. ¿PARA QUIÉN ES? — SEO content -->
  <section class="section section--warm" id="para-quien">
    <div class="container">
      <h2 class="section-title">¿A quién va dirigido nuestro servicio de nutrición en Alcorcón?</h2>
      <p class="section-sub">Atendemos a todo tipo de perfiles. Si te ves reflejado/a en alguna de estas situaciones, podemos echarte una mano:</p>
      <div class="para-quien-grid">
        <div class="para-quien-card">
          <span class="para-quien-icon">⚖️</span>
          <h3>Necesitas perder peso de forma real</h3>
          <p>Has intentado varias dietas y ninguna ha dado frutos duraderos. Buscas un enfoque que se adapte a tu vida cotidiana, sin pasar hambre y sin el temido rebote.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🏃</span>
          <h3>Entrenas y quieres mejorar tu rendimiento</h3>
          <p>Sales a correr, entrenas en el gimnasio, juegas al pádel o practicas CrossFit. Tu alimentación debería ir de la mano de tu entrenamiento. Te ayudamos a optimizarlo.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🩺</span>
          <h3>Tienes una patología que abordar</h3>
          <p>Diabetes tipo 2, colesterol elevado, hipertensión, SOP, problemas digestivos, intolerancias… La alimentación es una herramienta terapéutica de primer nivel y podemos acompañarte.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🔄</span>
          <h3>Simplemente quieres comer mejor</h3>
          <p>No tienes un objetivo de peso concreto, pero sabes que tu alimentación puede mejorar. Quieres entender qué comes, planificarte mejor y ganar vitalidad.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. TESTIMONIOS -->
  <section class="section section--alt" id="testimonios">
    <div class="container">
      <div class="testi-header">
        <span class="testi-stars-big">★★★★★</span>
        <h2 class="section-title">Opiniones de nuestros pacientes en Alcorcón</h2>
        <p class="section-sub">Algunas de las valoraciones que nos han dejado. Puedes encontrar más en nuestros perfiles de Google.</p>
      </div>
      <div class="resenas-grid">
        {testimonials.map(testimonial => (
          <TestimonialCard
            quote={testimonial.quote}
            author={testimonial.author}
            rating={testimonial.rating}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 12. SERVICIOS -->
  <section class="section" id="servicios">
    <div class="container">
      <h2 class="section-title">Servicios de nutrición en Alcorcón</h2>
      <p class="section-sub">Sea cual sea tu meta, nuestras nutricionistas en Alcorcón tienen una propuesta para ti. Cada consulta es diferente porque cada persona lo es.</p>
      <div class="servicios-grid">
        {serviciosData.map(servicio => (
          <ServiceCard
            emoji={servicio.emoji}
            title={servicio.title}
            description={servicio.shortDesc}
            href={`/${servicio.slug}`}
          />
        ))}
        <ServiceCard
          emoji="💻"
          title="Consulta online"
          description="La misma calidad sin moverte de casa. Videollamada, plan personalizado y seguimiento completo"
          href="/nutricionista-online"
        />
      </div>
    </div>
  </section>

  <!-- 13. BARRIOS (SEO local) -->
  <section class="section section--alt" id="barrios">
    <div class="container">
      <h2 class="section-title">Nutricionista cerca de ti en Alcorcón</h2>
      <p class="section-sub">Recibimos pacientes de todos los barrios de Alcorcón. Nuestra consulta está en una ubicación céntrica, a pocos minutos de cualquier punto del municipio.</p>
      <div class="barrios-grid">
        {barriosData.map(barrio => (
