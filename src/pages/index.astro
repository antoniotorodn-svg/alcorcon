---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CalendlySection from '../components/CalendlySection.astro';
import BarrioTag from '../components/BarrioTag.astro';
import MaterialFormativo from '../components/MaterialFormativo.astro';
import CTABox from '../components/CTABox.astro';
import barriosData from '../data/barrios.json';
import serviciosData from '../data/servicios.json';

const faqItems = [
  {
    question: "¿Dónde se encuentra vuestra consulta de nutrición en Fuenlabrada?",
    answer: "Estamos en la Calle Venezuela 4, en la parte trasera del edificio que da al parque. La zona tiene buena conexión con Cercanías Renfe (estación Fuenlabrada) y varias líneas de autobús interurbano, además de aparcamiento gratuito en las calles adyacentes."
  },
  {
    question: "¿Quiénes son los nutricionistas de Fuenlabrada?",
    answer: "En Fuenlabrada te atienden Adrián, Soraya y Cristina, tres dietistas-nutricionistas colegiados con experiencia contrastada en cambio de hábitos, pérdida de grasa y nutrición clínica. Forman parte del equipo de nutricionista.io, con el mismo sistema de trabajo que aplicamos en el resto de centros del sur de Madrid."
  },
  {
    question: "¿Qué incluye la primera consulta de nutrición?",
    answer: "Adrián, Soraya o Cristina harán una entrevista detallada para entender tus costumbres alimentarias, tu ritmo de vida, posibles intolerancias y tus objetivos concretos. En un plazo máximo de 72 horas recibirás por correo electrónico tu plan nutricional completo, con menús semanales adaptados, recetas y tu lista de la compra."
  },
  {
    question: "¿Cada cuánto tiempo se hacen las revisiones?",
    answer: "Las revisiones están programadas cada 21 días. En cada una analizamos tu evolución, resolvemos las dudas acumuladas y ajustamos tu plan según los avances. Entre citas puedes escribirnos por WhatsApp sin coste extra."
  },
  {
    question: "¿Cuánto cuesta el nutricionista en Fuenlabrada?",
    answer: "Primera consulta: 50€ (entrevista completa + plan nutricional + material formativo). Revisión: 40€. Pack de 4 sesiones (primera + 3 revisiones): 140€ — te ahorras 30€ respecto a contratarlas por separado. Aceptamos efectivo, tarjeta y Bizum."
  },
  {
    question: "¿Tendré que comprar suplementos o productos especiales?",
    answer: "No. Nuestros nutricionistas en Fuenlabrada trabajan exclusivamente con comida real, la que encuentras en cualquier supermercado de tu barrio. Sin batidos sustitutivos, sin suplementos obligatorios y sin gastos adicionales."
  },
  {
    question: "¿Cuál es el horario de la consulta de Fuenlabrada?",
    answer: "Atendemos de lunes a viernes en horario continuo de 9:00 a 20:30. Puedes reservar llamando al 623 99 89 39, por WhatsApp al mismo número o directamente desde el calendario de esta página."
  },
  {
    question: "¿Ofrecéis consulta de nutrición online?",
    answer: "Sí. Además de la consulta presencial en Fuenlabrada, disponemos de consulta online por videollamada con idéntico nivel de calidad, planificación personalizada y seguimiento. Perfecta si prefieres no desplazarte o vives fuera del municipio."
  },
  {
    question: "¿Atendéis a deportistas en Fuenlabrada?",
    answer: "Por supuesto. Tenemos experiencia en nutrición deportiva aplicada a running, CrossFit, pádel, ciclismo, natación y entrenamiento de fuerza. Adaptamos la alimentación a tus sesiones, competiciones y objetivos de rendimiento o composición corporal."
  },
  {
    question: "¿Puedo acudir si tengo una enfermedad o patología?",
    answer: "Sí. Trabajamos con diabetes tipo 2, colesterol, hipertensión, SOP, trastornos digestivos (SIBO, colon irritable, intolerancias), menopausia y otras patologías. Si es necesario, nos coordinamos con tu médico de cabecera o especialista."
  }
];

const testimonials = [
  {
    quote: "Llevaba años a dieta y por primera vez siento que estoy aprendiendo a comer de verdad. Los menús son variados, sabrosos y fáciles de preparar.",
    author: "Sandra M.",
    rating: 5
  },
  {
    quote: "Lo mejor es que no te quitan nada. Te enseñan a gestionar las comidas fuera de casa, los antojos y las situaciones sociales sin culpa.",
    author: "Javier R.",
    rating: 5
  },
  {
    quote: "Después del embarazo quería sentirme bien otra vez. Me prepararon un plan compatible con la lactancia y mis horarios caóticos. Genial.",
    author: "Laura T.",
    rating: 5
  },
  {
    quote: "Trabajo por turnos en el hospital y necesitaba alguien que entendiera mis horarios. Me dieron pautas realistas que puedo seguir cada semana.",
    author: "Raúl G.",
    rating: 5
  },
  {
    quote: "Mi médico me dijo que tenía que bajar el colesterol sí o sí. En tres meses, con los cambios de alimentación, los resultados fueron increíbles.",
    author: "Carmen P.",
    rating: 5
  },
  {
    quote: "El grupo de WhatsApp semanal es un acierto. Recetas nuevas, ideas prácticas y la sensación de que no estás solo en esto.",
    author: "Miguel Á.",
    rating: 5
  },
  {
    quote: "Vinimos mi pareja y yo juntos. Nos montaron un plan que funciona para los dos aunque tenemos gustos muy distintos. Cenamos genial cada noche.",
    author: "Ana y David",
    rating: 5
  },
  {
    quote: "Sufría hinchazón después de cada comida. En pocas semanas noté un cambio brutal. Ojalá hubiera dado el paso mucho antes.",
    author: "Pilar F.",
    rating: 5
  },
  {
    quote: "Me han enseñado que el peso es solo un número más. Lo importante es cómo me siento, y ahora me siento mejor que nunca.",
    author: "Roberto J.",
    rating: 5
  },
  {
    quote: "El material formativo que recibes en cada revisión vale oro. He aprendido más en dos meses que en años buscando por internet.",
    author: "Marta H.",
    rating: 5
  },
  {
    quote: "Son directos y transparentes. Nada de tecnicismos ni vender humo: te explican todo para que lo entiendas y lo pongas en práctica.",
    author: "Francisco L.",
    rating: 5
  },
  {
    quote: "He recuperado una energía que creía perdida. Descanso mejor, rindo más entrenando y hasta mi piel ha mejorado. Muy contenta.",
    author: "Elena C.",
    rating: 5
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HealthBusiness",
  "name": "Nutricionista en Fuenlabrada — Adrián, Soraya y Cristina",
  "description": "Consulta de nutrición en Fuenlabrada. Dietistas-nutricionistas colegiados especializados en pérdida de peso, nutrición deportiva, salud digestiva y hormonal.",
  "url": "https://nutricionista.io/nutricionista-en-fuenlabrada",
  "telephone": "+34623998939",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle Venezuela, 4",
    "addressLocality": "Fuenlabrada",
    "addressRegion": "Madrid",
    "postalCode": "28943",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.2838,
    "longitude": -3.7948
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "20:30"
    }
  ],
  "priceRange": "40€ - 140€",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "38"
  }
};
---

<BaseLayout
  title="Nutricionista en Fuenlabrada | C/ Venezuela 4 · Primera consulta 50€"
  description="Nutricionistas colegiados en Fuenlabrada. Planes personalizados para perder peso, nutrición deportiva, salud digestiva y hormonal. C/ Venezuela 4. Primera consulta 50€. Reserva hoy."
  schema={faqSchema}
>
  <Nav slot="nav" />

  <!-- Schema LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- 1. HERO — foto del equipo + vídeo vertical -->
  <Hero
    name="Nutricionista en Fuenlabrada"
    role="Cuida tu alimentación con profesionales"
    showVideo={true}
    location="C/ Venezuela 4 · Fuenlabrada"
    description=""
    benefits={[]}
  />

  <!-- Trust Strip -->
  <TrustStrip />

  <!-- 2. INTRO SEO — Texto largo para posicionamiento -->
  <section class="section" id="nutricionista-fuenlabrada">
    <div class="container">
      <div class="seo-intro">
        <h2 class="section-title">Nutricionistas en Fuenlabrada: el primer paso hacia un cambio real</h2>
        <div class="seo-intro__text">
          <p><strong>Somos Adrián, Soraya, Cristina y Antonio.</strong> Desde 2017 hemos desarrollado un sistema de trabajo que hoy aplicamos en esta consulta y en el resto de centros que coordinamos en el sur de Madrid: <strong>Leganés, Alcorcón, Getafe y Móstoles.</strong></p>
          <p>Si buscas un <strong>nutricionista en Fuenlabrada</strong> que se involucre de verdad en tu caso, que conozca las particularidades de tu día a día y que diseñe un plan pensado para tu realidad, has llegado al lugar adecuado. Aquí no encontrarás dietas fotocopiadas ni menús genéricos: cada persona merece una estrategia propia.</p>
          <p>Nuestro método se sustenta en tres pilares: <strong>comida real</strong> (sin sustitutivos ni productos milagro), <strong>educación nutricional</strong> (para que comprendas el porqué de cada decisión) y <strong>acompañamiento continuo</strong> (contacto directo por WhatsApp entre consultas).</p>
          <p style="font-weight: 700; color: var(--text);">A continuación te contamos cómo trabajamos y qué podemos hacer por ti.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PROCESO — ¿Cómo funciona? -->
  <section class="section section--warm" id="proceso">
    <div class="container">
      <h2 class="section-title">¿Cómo funciona el proceso?</h2>
      <div class="proceso-grid">
        <div class="proceso-card">
          <div class="proceso-icon">📋</div>
          <h3>Primera consulta</h3>
          <p>Conocemos a fondo tu situación actual, completamos un cuestionario personalizado y definimos la mejor estrategia para tu objetivo concreto.</p>
        </div>
        <div class="proceso-card">
          <div class="proceso-icon">📩</div>
          <h3>Recibes tu plan</h3>
          <p>En un plazo máximo de 72 horas tendrás tu planificación nutricional en el correo. A partir de ese momento, estamos a tu disposición para cualquier duda.</p>
        </div>
        <div class="proceso-card">
          <div class="proceso-icon">📊</div>
          <h3>Revisiones periódicas</h3>
          <p>Cada 21 días nos vemos para valorar tu evolución, actualizar el plan si hace falta y entregarte nuevo material formativo que te ayude a seguir avanzando.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PRECIOS -->
  <section class="section" id="precios">
    <div class="container">
      <h2 class="section-title">Precios: Nutricionista en Fuenlabrada</h2>
      <p class="section-sub">Elige la modalidad que mejor se adapte a tu situación.</p>

      <div class="pricing-row">
        <!-- Sesión individual -->
        <div class="price-basic">
          <div class="price-basic-label">Sesión individual</div>
          <div class="price-basic-header">Primera consulta</div>
          <div class="price-basic-amount">50<span>€</span></div>
          <ul class="price-basic-list">
            <li>✓ Entrevista inicial en profundidad</li>
            <li>✓ Plan nutricional a tu medida</li>
            <li>✓ Material formativo incluido</li>
          </ul>
          <div class="price-basic-revision">Revisiones sueltas: 40€/sesión</div>
          <a href="#reservar" class="price-basic-btn">PEDIR CITA</a>
        </div>

        <!-- Pack destacado -->
        <div class="price-pack">
          <div class="pack-badge-top">⭐ MÁS ELEGIDO — AHORRA 30€</div>
          <div class="pack-header">
            <h3>Pack: Primera + 3 Revisiones</h3>
            <p>La opción más completa</p>
          </div>
          <div class="pack-price-row">
            <div class="pack-old-price">170€</div>
            <div class="pack-new-price">140<span>€</span></div>
          </div>
          <div class="pack-savings">Ahorro de 30€ respecto a contratar por separado</div>
          <ul class="pack-features">
            <li>4 sesiones completas incluidas</li>
            <li>Plan nutricional + ajustes en cada visita</li>
            <li>Soporte por WhatsApp entre consultas</li>
            <li>Todo el material formativo</li>
            <li>Mayor compromiso, mejores resultados</li>
          </ul>
          <a href="#reservar" class="pack-btn">PEDIR CITA</a>
        </div>
      </div>

      <!-- Nota parejas -->
      <div class="parejas-note">
        <p class="parejas-title">💑 <strong>Consultas en pareja</strong></p>
        <p class="parejas-detail">Primera consulta pareja: 100€ · Revisión pareja: 55€ · Bono 4 consultas parejas: 220€</p>
        <a href="#reservar" class="parejas-btn">Reservar cita para 2 personas</a>
      </div>
    </div>
  </section>

  <!-- 5. UBICACIÓN + MAPA -->
  <section class="section section--alt" id="ubicacion">
    <div class="container">
      <h2 class="section-title">¿Dónde está nuestra consulta en Fuenlabrada?</h2>
      <div class="location-box">
        <div class="location-info">
          <div class="location-row">
            <span class="location-icon">📍</span>
            <div>
              <strong>Dirección</strong>
              <span>Calle Venezuela 4 (Parte trasera, da al parque), Fuenlabrada</span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">📞</span>
            <div>
              <strong>Teléfono</strong>
              <span><a href="tel:+34623998939">623 99 89 39</a></span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">💬</span>
            <div>
              <strong>WhatsApp</strong>
              <span><a href="https://wa.me/34623998939?text=Hola%2C%20quiero%20informarme%20sobre%20la%20consulta%20en%20Fuenlabrada" target="_blank" rel="noopener">623 99 89 39</a></span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">🕐</span>
            <div>
              <strong>Horarios</strong>
              <span>Lunes a Viernes: 9:00–20:30</span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">🚇</span>
            <div>
              <strong>Cómo llegar</strong>
              <span>Cercanías Renfe · Autobuses interurbanos · Parking en superficie</span>
            </div>
          </div>
          <div class="location-actions">
            <a href="tel:+34623998939" class="loc-btn loc-btn--primary">Llamar al 623 99 89 39</a>
            <a href="https://wa.me/34623998939?text=Hola%2C%20quiero%20informarme%20sobre%20la%20consulta%20en%20Fuenlabrada" target="_blank" rel="noopener" class="loc-btn loc-btn--outline">Enviar WhatsApp</a>
          </div>
        </div>
        <div class="location-map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3016.5!2d-3.7948!3d40.2838!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd418e0000000000%3A0x0000000000000000!2sC.%20de%20Venezuela%2C%204%2C%2028943%20Fuenlabrada!5e0!3m2!1ses!2ses!4v1710000000000!5m2!1ses!2ses"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Nutricionista en Fuenlabrada — C/ Venezuela 4"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. RESERVA CITA (Calendly con tabs) -->
  <CalendlySection />

  <!-- 7. FAQ -->
  <section class="section section--warm" id="faq">
    <div class="container">
      <h2 class="section-title">Preguntas frecuentes sobre el nutricionista en Fuenlabrada</h2>
      <p class="section-sub">Todo lo que necesitas saber antes de tu primera visita:</p>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <!-- CTA intermedio -->
  <CTABox
    title="¿Listo/a para empezar?"
    description="Reserva tu primera consulta con nuestros nutricionistas en Fuenlabrada. 50€, sin permanencia. Llama al 623 99 89 39 o escríbenos por WhatsApp."
    ctaText="Reservar mi cita"
    ctaHref="#reservar"
    variant="trust"
  />

  <!-- 8. QUÉ NOS DIFERENCIA -->
  <section class="section section--alt" id="diferencia">
    <div class="container">
      <h2 class="section-title">¿Por qué confiar en nuestros nutricionistas en Fuenlabrada?</h2>
      <div class="diff-text">
        <p>Nutricionista.io nació en 2017 con un solo profesional. A día de hoy <strong>somos un equipo de 20 dietistas-nutricionistas</strong> con consultas presenciales en Fuenlabrada, Leganés, Alcorcón, Getafe y Móstoles, además de consulta online para toda España.</p>
        <p>Después de miles de pacientes atendidos, hemos perfeccionado un método que se centra en lo que de verdad funciona: <strong>comida real, formación nutricional sólida y seguimiento permanente.</strong> Sin atajos y sin promesas vacías.</p>
        <p>En nuestra consulta de Fuenlabrada no solo recibes un plan nutricional personalizado. Te proporcionamos las herramientas para que el cambio sea duradero:</p>
      </div>

      <!-- Tres pilares destacados -->
      <div class="pilares-grid">
        <div class="pilar-card">
          <div class="pilar-num">1</div>
          <h3>Dossiers formativos en cada revisión</h3>
          <p>Material práctico sobre etiquetado, metabolismo, gestión de la saciedad, adherencia y mucho más. No solo te indicamos qué comer: te enseñamos por qué.</p>
        </div>
        <div class="pilar-card">
          <div class="pilar-num">2</div>
          <h3>Área de Pacientes privada</h3>
          <p>Acceso a más de 110 recursos: vídeos, guías descargables, infografías, calculadoras y recetarios clasificados por temática.</p>
        </div>
        <div class="pilar-card">
          <div class="pilar-num">3</div>
          <h3>Grupo de WhatsApp semanal</h3>
          <p>Recetas, análisis de productos del supermercado, ideas de batch cooking y apoyo continuo entre consultas. Nunca caminas solo/a en este proceso.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. MATERIAL FORMATIVO -->
  <section class="section" id="material">
    <div class="container">
      <h2 class="section-title">Material formativo incluido</h2>
      <p class="section-sub">En cada revisión con tu nutricionista en Fuenlabrada recibirás un dossier nuevo. Temas como el etiquetado, pérdida de grasa, metabolismo y adherencia:</p>
      <MaterialFormativo />
    </div>
  </section>

  <!-- 10. ¿PARA QUIÉN ES? — SEO content -->
  <section class="section section--warm" id="para-quien">
    <div class="container">
      <h2 class="section-title">¿A quién va dirigido nuestro servicio de nutrición en Fuenlabrada?</h2>
      <p class="section-sub">Trabajamos con todo tipo de perfiles. Si alguna de estas situaciones te resulta familiar, podemos ayudarte:</p>
      <div class="para-quien-grid">
        <div class="para-quien-card">
          <span class="para-quien-icon">⚖️</span>
          <h3>Quieres perder peso de forma sostenible</h3>
          <p>Has probado varias dietas sin éxito a largo plazo. Necesitas un planteamiento que encaje con tu rutina, sin pasar hambre y sin el temido efecto rebote.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🏃</span>
          <h3>Haces deporte y quieres optimizar tu rendimiento</h3>
          <p>Corres, entrenas en el gym, juegas al pádel o practicas CrossFit. Tu alimentación debería potenciar tus entrenamientos, no frenarlos. Te ayudamos a alinear ambos.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🩺</span>
          <h3>Necesitas abordar una patología</h3>
          <p>Diabetes tipo 2, colesterol alto, hipertensión, SOP, problemas digestivos, intolerancias… La alimentación es una herramienta terapéutica clave y podemos acompañarte.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🔄</span>
          <h3>Quieres aprender a comer mejor</h3>
          <p>No persigues un número en la báscula, pero sabes que tu alimentación tiene margen de mejora. Buscas organizarte, comprar con criterio y ganar vitalidad.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. TESTIMONIOS -->
  <section class="section section--alt" id="testimonios">
    <div class="container">
      <div class="testi-header">
        <span class="testi-stars-big">★★★★★</span>
        <h2 class="section-title">Opiniones de nuestros pacientes en Fuenlabrada</h2>
        <p class="section-sub">Algunas de las valoraciones que nos han dejado. Puedes encontrar más en nuestros perfiles de Google.</p>
      </div>
      <div class="resenas-grid">
        {testimonials.map(testimonial => (
          <TestimonialCard
            quote={testimonial.quote}
            author={testimonial.author}
            rating={testimonial.rating}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 12. SERVICIOS -->
  <section class="section" id="servicios">
    <div class="container">
      <h2 class="section-title">Servicios de nutrición en Fuenlabrada</h2>
      <p class="section-sub">Sea cual sea tu objetivo, nuestros nutricionistas en Fuenlabrada tienen una propuesta para ti. Cada consulta es diferente porque cada persona lo es.</p>
      <div class="servicios-grid">
        {serviciosData.map(servicio => (
          <ServiceCard
            emoji={servicio.emoji}
            title={servicio.title}
            description={servicio.shortDesc}
            href={`/${servicio.slug}`}
          />
        ))}
        <ServiceCard
          emoji="💻"
          title="Consulta online"
          description="La misma calidad sin moverte de casa. Videollamada, plan personalizado y seguimiento completo"
          href="/nutricionista-online"
        />
      </div>
    </div>
  </section>

  <!-- 13. BARRIOS (SEO local) -->
  <section class="section section--alt" id="barrios">
    <div class="container">
      <h2 class="section-title">Nutricionista cerca de ti en Fuenlabrada</h2>
      <p class="section-sub">Atendemos a pacientes de todas las zonas de Fuenlabrada. Nuestra consulta está bien comunicada y a pocos minutos de cualquier barrio del municipio.</p>
